{
  "name": "jp-ipms-api",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register src/server.ts",
    "start": "ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p . && tsc-alias",
    "postbuild": "copy package*.json dist && copy *.env dist  && cd dist && mkdir temp",
    "production": "nodemon server.js"
  },
  "keywords": [
    "ipms",
    "api",
    "express",
    "typescript"
  ],
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^4.1.4",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "edge-js": "^25.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "http-errors": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.9",
    "omron-fins": "^0.5.0",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.10",
    "@types/pg": "^8.18.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescipt": "^1.0.0"
  }
}
